# Create a separate .env file on the deployment host and chmod 600 it.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET_KEY
MEDIA_AGENT_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
MEDIA_ROOT=/media

# Optional heartbeat registration to the existing Dart backend.
BACKEND_HEARTBEAT_URL=http://192.168.1.20:8080/api/v1/server-agent/heartbeat
SERVER_ID=YOUR_EXISTING_HOME_SERVER_UUID
AGENT_ID=truenas-media-agent-01
NAS_NAME=Home TrueNAS
