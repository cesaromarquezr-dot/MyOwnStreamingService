# Copy to /etc/myownstreamingservice/restore.env and set mode 0600.
# Do not commit actual credentials or private identities.
AGE_IDENTITY=/secure/path/to/age-identity.txt
RESTORE_WORK_ROOT=/dev/shm/myownstreamingservice-restore
SUPABASE_DB_URL=postgresql://replace-me
SUPABASE_TARGET_LABEL=staging
CONFIRM_RESTORE=RESTORE
# Set only after review; production targets are blocked without this exact value.
# ALLOW_PRODUCTION_RESTORE=I_HAVE_VERIFIED_BACKUP_AND_TARGET
