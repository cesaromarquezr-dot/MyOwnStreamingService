# MyOwnStreamingService — BACKEND ONLY
# Copy this file to .env in the Backend folder before starting the Dart server.
# Do not copy any values from this file into the Flutter project's root .env.
# Values supplied by the operating system take precedence when the server is deployed.

# Supabase server-only configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Metadata providers (keep all provider credentials in Backend/.env)
# Use either TMDB v3 API key or TMDB Read Access Token; token is preferred.
TMDB_API_KEY=
TMDB_API_TOKEN=
OMDB_API_KEY=
LASTFM_API_KEY=
MUSIC_METADATA_USER_AGENT="MyOwnStreamingService/1.0 (self-hosted)"
# Spotify Web API (metadata discovery only; never put these in the Flutter .env)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube Data API v3 key for discovering embeddable music-video matches.
# Keep this value in Backend/.env only; never put it in Flutter's root .env.
YOUTUBE_API_KEY=
# Licensed lyric phrase search (metadata only; configure access/terms with provider).
MUSIXMATCH_API_KEY=
# Optional audio fingerprint recognition provider; keep this token server-side.
AUDD_API_TOKEN=
GEONAMES_USERNAME=

# Payment provider credentials — keep server-side only
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
MERCADO_PAGO_ACCESS_TOKEN=
APPLE_PAY_MERCHANT_ID=

# Email provider / SMTP (optional)
EMAIL_PROVIDER_API_KEY=
TRANSLATE_API_KEY=
STREAM_PLATFORM_ADMIN_KEY=
SMTP_HOST=
STREAM_EMAIL_HOST=
STREAM_EMAIL_PORT=587
STREAM_EMAIL_USERNAME=
STREAM_EMAIL_PASSWORD=
STREAM_EMAIL_FROM=
STREAM_EMAIL_SSL=true

# Backend and media-agent security
SERVER_HOST=0.0.0.0
SERVER_PUBLIC_URL=https://127.0.0.1:8080
BACKEND_TLS_ENABLED=true
PROXY_SHARED_SECRET=
MEDIA_AGENT_BASE_URL=
MEDIA_AGENT_SHARED_SECRET=
SUPPORT_ADMIN_ACCOUNT_IDS=
SECURITY_BOT_ADMIN_ACCOUNT_IDS=
ARM_SERVER_URL=
ARM_USERNAME=
ARM_PASSWORD=

# Translation key may be used as a Supabase Edge Function secret; set it in that function environment.
